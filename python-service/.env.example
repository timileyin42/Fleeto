# Copy to .env and fill in values — never commit .env

# ── Database ───────────────────────────────────────────────────────────────────
# Docker local (matches docker-compose.yml defaults):
DATABASE_URL=postgresql+asyncpg://fleeto:fleeto_dev@localhost:5432/fleeto

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Firebase ───────────────────────────────────────────────────────────────────
# Encode service account JSON:
#   base64 -i fleeto-60a7a-firebase-adminsdk-fbsvc-8732abe2fa.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# From Twilio Console → Account Info (top of dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Sandbox number — keep this as-is during development
TWILIO_WHATSAPP_FROM=+14155238886

# Public URL of your frontend — used in the tracking link sent to customers
# During dev: http://localhost:3000  |  Production: https://yourdomain.com
APP_BASE_URL=http://localhost:3000

# ── Maps ───────────────────────────────────────────────────────────────────────
# Google Maps JS API key (frontend only — restrict to your domain in prod)
GOOGLE_MAPS_API_KEY=
